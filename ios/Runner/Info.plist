<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<key>CFBundleDisplayName</key>
	<string>Qars Spin</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundleName</key>
	<string>Qars Spin</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>

	<key>CFBundleSignature</key>
	<string>????</string>

	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
	</array>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Qars Spin needs access to your photos to attach images when sharing a car or showroom.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Qars Spin needs permission to save shared images to your photo library.</string>

	<!--
	Firebase Messaging by default performs method swizzling on the
	app delegate to intercept remote-notification callbacks AND to
	install itself as the UNUserNotificationCenter delegate. That
	swizzling was silently dropping our locally-fired notifications
	on iOS (they never appeared as a banner AND never showed up in
	the Notification Center) because iOS asked Firebase's proxied
	delegate how to present them and got no useful answer.

	We are not currently using any FCM remote push notifications —
	every notification the app posts is local via
	`flutter_local_notifications`. So disabling the proxy is safe:
	`flutter_local_notifications` becomes the sole
	UNUserNotificationCenter delegate and its foreground
	presentation options (banner / list / sound) are honored.

	If FCM push notifications are wired up later, this flag must
	either be flipped back to YES OR the AppDelegate must manually
	forward the notification callbacks to Firebase — see
	https://firebase.google.com/docs/cloud-messaging/ios/client#method_swizzling_in_firebase_messaging
	-->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
</dict>
</plist>